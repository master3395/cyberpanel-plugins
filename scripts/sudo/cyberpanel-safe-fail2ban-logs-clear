#!/usr/bin/env bash
# Allowlisted: truncate only /var/log/fail2ban.log (active log file).
set -euo pipefail
file="/var/log/fail2ban.log"
if [[ ! -e "$file" ]]; then
  exit 0
fi
if [[ ! -f "$file" ]]; then
  echo "cyberpanel-safe-fail2ban-logs-clear: not a regular file" >&2
  exit 1
fi
# Truncate in place; keep ownership/mode.
: > "$file"
